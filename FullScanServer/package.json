{
  "name": "fullscanfield-server",
  "version": "1.0.0",
  "description": "FullScanField REST API — assignments, evidence upload, UI config",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm --prefix web-fe run dev",
    "dev:admin-web": "npm --prefix web-admin run dev",
    "build": "tsc && npm run copy:seed",
    "copy:seed": "node -e \"require('fs').cpSync('src/db/seed', 'dist/db/seed', { recursive: true })\"",
    "build:web": "npm --prefix web-fe ci && npm --prefix web-fe run build",
    "build:admin-web": "npm --prefix web-admin ci && npm --prefix web-admin run build",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:web": "npm --prefix web-fe test",
    "test:admin-web": "npm --prefix web-admin test",
    "lint": "eslint src/",
    "migrate": "tsx src/db/migrate.ts",
    "db:dev": "tsx scripts/dev-mongo.ts",
    "db:generate-seed": "tsx scripts/generate-mongo-seed.ts",
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "geolib": "^3.3.4",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.6.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "better-sqlite3": "^11.0.0",
    "eslint": "^9.0.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "~13.1.3",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
