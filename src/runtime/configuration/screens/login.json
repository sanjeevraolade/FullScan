{
  "screenId": "login",
  "version": 1,
  "titleKey": "screen.login.title",
  "workflowId": "login",
  "layout": "scroll",
  "visible": true,
  "sections": [
    {
      "sectionId": "branding",
      "titleKey": "screen.login.title",
      "layout": "vertical",
      "order": 1,
      "visible": true,
      "widgets": [
        {
          "widgetId": "welcomeMessage",
          "type": "text",
          "labelKey": "login.welcome",
          "visible": true,
          "order": 1
        }
      ]
    },
    {
      "sectionId": "credentials",
      "titleKey": "section.login.credentials",
      "layout": "vertical",
      "order": 2,
      "visible": true,
      "widgets": [
        {
          "widgetId": "username",
          "type": "textInput",
          "labelKey": "login.fields.username",
          "binding": "session.credentials.username",
          "required": true,
          "visible": true,
          "order": 1
        },
        {
          "widgetId": "password",
          "type": "password",
          "labelKey": "login.fields.password",
          "binding": "session.credentials.password",
          "required": true,
          "visible": true,
          "order": 2
        },
        {
          "widgetId": "rememberMe",
          "type": "checkbox",
          "labelKey": "login.fields.rememberMe",
          "binding": "session.credentials.rememberMe",
          "required": false,
          "visible": true,
          "order": 3
        },
        {
          "widgetId": "employeeId",
          "type": "textInput",
          "labelKey": "login.fields.employeeId",
          "binding": "session.credentials.employeeId",
          "required": false,
          "visible": true,
          "order": 4
        }
      ]
    }
  ],
  "actions": ["submit"]
}
